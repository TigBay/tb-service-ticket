{% block tb_service_ticket_list %}
    <sw-page class="tb-service-ticket-list">

        {% block tb_service_ticket_list_search_bar %}
            <template #search-bar>
                <sw-search-bar
                        initial-search-type="tb_service_ticket"
                        :placeholder="$t('tb-service-ticket.general.placeholderSearchBar')"
                        :initial-search="term"
                        @search="onSearch"
                />
            </template>
        {% endblock %}

        {% block tb_service_ticket_list_smart_bar_header %}
            <template #smart-bar-header>
                <h2>
                    {{ $t('tb-service-ticket.list.titlePage') }}
                    <span
                            v-if="!isLoading && serviceTickets && total"
                            class="sw-page__smart-bar-amount"
                    >
                        ({{ total }})
                    </span>
                </h2>
            </template>
        {% endblock %}

        {% block tb_service_ticket_list_actions %}
            <template #smart-bar-actions>
                <mt-button
                        class="tb-service-ticket-list__create"
                        variant="primary"
                        :disabled="!acl.can('tb_service_ticket.creator') || undefined"
                        size="default"
                        @click="$router.push({ name: 'tb.service.ticket.create' })"
                >
                    {{ $t('tb-service-ticket.list.buttonCreate') }}
                </mt-button>
            </template>
        {% endblock %}

        {% block tb_service_ticket_list_content %}
            <template #content>
                <sw-card-view>
                    <mt-card position-identifier="tb-service-ticket-list-content">
                        {% block tb_service_ticket_list_grid %}
                            <template #grid>
                                <sw-entity-listing
                                        class="tb-service-ticket-list-grid"
                                        :repository="serviceTicketRepository"
                                        :is-loading="isLoading"
                                        :data-source="serviceTickets"
                                        :columns="columns"
                                        identifier="tb-service-ticket-list"
                                        :sort-by="sortBy"
                                        :sort-direction="sortDirection"
                                        :full-page="false"
                                        detail-route="tb.service.ticket.detail"
                                        :disable-data-fetching="true"
                                        :show-selection="acl.can('tb_service_ticket.deleter') || undefined"
                                        :allow-edit="acl.can('tb_service_ticket.editor') || undefined"
                                        :allow-view="acl.can('tb_service_ticket.viewer') || undefined"
                                        :allow-delete="acl.can('tb_service_ticket.deleter') || undefined"
                                        @column-sort="onSortColumn"
                                        @page-change="onPageChange"
                                >
                                    <template #column-status="{ item }">
                                        {{ $t(`tb-service-ticket.detail.statusOptions.${item.status}`) }}
                                    </template>

                                    <template #column-createdAt="{ item }">
                                        {{ dateFilter(item.createdAt, { hour: '2-digit', minute: '2-digit' }) }}
                                    </template>

                                    <template #column-priority="{ item }">
                                        <mt-badge :variant="getPriorityBadgeVariant(item.priority)">
                                            {{ $t(`tb-service-ticket.detail.priorityOptions.${item.priority}`) }}
                                        </mt-badge>
                                    </template>
                                </sw-entity-listing>
                            </template>
                        {% endblock %}
                    </mt-card>
                </sw-card-view>
            </template>
        {% endblock %}

    </sw-page>
{% endblock %}
